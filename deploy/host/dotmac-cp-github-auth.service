[Unit]
Description=Renew the control-plane ledger GitHub App lease
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/dotmac/vendor-control-plane/operator/bin/dotmac-platform --format json admin github-auth-renew
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/secrets/dotmac/platform-cp/github /var/lock
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER

