-- a2 recovery observer role (C5), per-run template. Substitutions: <N> (run number) and <VALID_UNTIL> only.
-- psql variables supplied at run time (not substitutions): :'scram_verifier' (SCRAM verifier only), :"dbname".
BEGIN;
CREATE ROLE a2_recovery_observer_r<N> LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
  NOREPLICATION NOBYPASSRLS NOINHERIT CONNECTION LIMIT 2
  VALID UNTIL '<VALID_UNTIL>' PASSWORD :'scram_verifier';
ALTER ROLE a2_recovery_observer_r<N> SET default_transaction_read_only = on;
ALTER ROLE a2_recovery_observer_r<N> SET statement_timeout = '5s';
ALTER ROLE a2_recovery_observer_r<N> SET lock_timeout = '2s';
ALTER ROLE a2_recovery_observer_r<N> SET idle_in_transaction_session_timeout = '10s';
GRANT CONNECT ON DATABASE :"dbname" TO a2_recovery_observer_r<N>;
GRANT USAGE ON SCHEMA mod_deploy, public TO a2_recovery_observer_r<N>;
GRANT SELECT ON mod_deploy.rollouts, mod_deploy.rollout_attempts,
  mod_deploy.rollout_attempt_settlements, public.platform_idempotency_records
  TO a2_recovery_observer_r<N>;
COMMIT;
