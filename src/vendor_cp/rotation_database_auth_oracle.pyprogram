# A database-authentication oracle for the deployed application's interpreter.
# The host adapter streams one role/password pair on stdin and receives only the
# role name plus an accepted/refused bit. No credential, DSN, host coordinate,
# or exception text is returned.
#
# The source URL comes from the application's installed database runtime. Its
# `db:5432` coordinate is the Compose bridge path used by the application, so it
# selects the final `host all all all scram-sha-256` rule in production rather
# than the earlier 127.0.0.1 trust rule inside the PostgreSQL container.
import json
import sys

from sqlalchemy import create_engine, text
from sqlalchemy.exc import OperationalError

from dotmac_kernel.db import engine


ROLE_SET = {"app_admin", "app_user", "platform_api"}
SCHEMA = "platform-database-authentication-oracle.v1"


def refuse(code):
    raise SystemExit(code)


try:
    request = json.load(sys.stdin)
except Exception:
    refuse(2)

if not isinstance(request, dict) or set(request) != {"schema", "role", "password"}:
    refuse(2)
if request.get("schema") != SCHEMA:
    refuse(2)
role = request.get("role")
password = request.get("password")
if role not in ROLE_SET or not isinstance(password, str) or not password:
    refuse(2)

source = engine.url
if source.host != "db" or (source.port or 5432) != 5432:
    # A loopback/socket probe could select a trust rule and answer "accepted"
    # for every password. The transport is therefore part of the proof.
    refuse(3)

probe = create_engine(
    source.set(username=role, password=password),
    pool_pre_ping=False,
)
try:
    with probe.connect() as connection:
        bridge_path = connection.execute(
            text(
                "SELECT inet_client_addr() IS NOT NULL "
                "AND inet_server_addr() IS NOT NULL "
                "AND NOT inet_client_addr() <<= inet '127.0.0.0/8' "
                "AND inet_client_addr() <> inet '::1'"
            )
        ).scalar_one()
        if bridge_path is not True:
            refuse(3)
    accepted = True
except OperationalError as error:
    # 28P01 is PostgreSQL's invalid_password result. Network, DNS, startup,
    # TLS and every other failure are not evidence that a password was refused.
    if getattr(error.orig, "sqlstate", None) != "28P01":
        refuse(4)
    accepted = False
finally:
    probe.dispose()

print(
    json.dumps(
        {"schema": SCHEMA, "role": role, "accepted": accepted},
        sort_keys=True,
        separators=(",", ":"),
    )
)
