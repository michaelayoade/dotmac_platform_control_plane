[Unit]
Description=Fixed native envelope observer
DefaultDependencies=no
Conflicts=@@OBSERVER_EXPIRED@@
Requisite=@@OBSERVER_READY@@
After=@@OBSERVER_READY@@
[Service]
Type=exec
ExitType=main
ExecStart=/usr/local/libexec/dotmac-gate0-native-envelope/adapter
User=0
Group=0
Restart=no
SuccessExitStatus=
RemainAfterExit=no
KillMode=control-group
KillSignal=SIGKILL
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=@@T_US@@us
Delegate=no
LimitCORE=0
LimitFSIZE=@@DIAGNOSTIC_MAX@@
CPUQuota=@@CPU_QUOTA@@%
MemoryMax=@@MEMORY_MAX@@
TasksMax=@@TASKS_MAX@@
StandardInput=null
StandardOutput=append:@@OUTPUT@@
StandardError=append:@@DIAGNOSTIC@@
