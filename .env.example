# The ONE control-plane database (the kernel owns the engine). No product DSNs.
DATABASE_URL=postgresql+psycopg://app_user:app_user@localhost:5432/vendor_control_plane
PLATFORM_DATABASE_URL=postgresql+psycopg://platform_api:platform_api@localhost:5432/vendor_control_plane
# Provisioning provider mode — only "fake" is permitted in this phase.
VENDOR_PROVIDER_MODE=fake
# Product-qualified capability snapshots materialised from target application
# manifests. An empty object is fail-closed: no product can publish or submit an
# offer until its catalogue is supplied. Never use the removed unscoped
# VENDOR_OFFERED_CAPABILITIES setting.
VENDOR_PRODUCT_MANIFEST_CAPABILITIES_JSON={}
# Forgejo read credential for installing dotmac-kernel (value lives in OpenBao).
# POETRY_HTTP_BASIC_FORGEJO_USERNAME=...
# POETRY_HTTP_BASIC_FORGEJO_PASSWORD=...
