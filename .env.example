# The ONE control-plane database (the kernel owns the engine). No product DSNs.
DATABASE_URL=postgresql+psycopg://app_user:app_user@localhost:5432/vendor_control_plane
PLATFORM_DATABASE_URL=postgresql+psycopg://platform_api:platform_api@localhost:5432/vendor_control_plane
# Provisioning provider mode — only "fake" is permitted in this phase.
VENDOR_PROVIDER_MODE=fake
# Exact operator-selected product release evidence. Capability codes are never
# configured here: the service verifies the pinned manifest digest is attested
# for the pinned OCI artifact and derives codes from the held canonical bytes.
# Empty is fail-closed: no product can publish or submit an offer.
VENDOR_PRODUCT_RELEASE_PINS_JSON={}
# Read-only mount holding canonical documents named by file:// attestation URIs.
VENDOR_PRODUCT_MANIFEST_DIRECTORY=/run/dotmac/product-manifests
# Development/test issuer. Production validation refuses this mode and requires
# an OpenBao-held configured key before the assembly composes.
VENDOR_LICENCE_SIGNING_MODE=ephemeral
VENDOR_LICENCE_SIGNING_KEY_FILE=
VENDOR_LICENCE_SIGNING_KEY_ID=
VENDOR_LICENCE_OVERLAP_KEY_FILE=
VENDOR_LICENCE_OVERLAP_KEY_ID=
VENDOR_LICENCE_DELIVERY_MODE=logging
# Forgejo read credential for installing dotmac-kernel (value lives in OpenBao).
# POETRY_HTTP_BASIC_FORGEJO_USERNAME=...
# POETRY_HTTP_BASIC_FORGEJO_PASSWORD=...
# The platform outbox relay's DISPATCHER credential — the
# `platform_outbox_dispatcher` role, a third role on the ONE control-plane
# database above, never a second database. Empty is fail-closed: `dotmac-platform
# relay drain` refuses rather than reporting that it drained nothing.
VENDOR_RELAY_DISPATCHER_DATABASE_URL=
# How long a due platform outbox event may stay pending before the relay is
# judged not to be draining, and how long a claimed row may hold its lease
# before the claim is judged abandoned. The second must never be tighter than
# the kernel's own RelayPolicy.stale_lease_seconds.
VENDOR_RELAY_OVERDUE_SECONDS=300
VENDOR_RELAY_STALE_LEASE_SECONDS=300
# How long the freshest heartbeat may age before the relay reads as STOPPED,
# and how recently something must have settled for an overdue backlog to read
# as BEHIND rather than WEDGED.
VENDOR_RELAY_HEARTBEAT_STALE_SECONDS=120
VENDOR_RELAY_SETTLED_WITHIN_SECONDS=600
# Whether THIS deployment runs a relay. True is the fail-closed default; a
# developer machine running only the app says false and gets the
# queue-derived signals without the heartbeat.
VENDOR_RELAY_EXPECTED=true
