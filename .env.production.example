# Host/deploy identity. These exact markers prevent a staging or unrelated host
# from accepting a production deployment.
APP_ENV=production
SERVER_NAME=vendor-cp-prod
ENVIRONMENT=production
# Which vendor surfaces this deployment publishes (src/vendor_cp/
# deployment_profile.py). `production-bootstrap` composes and runs everything
# but does not mount the licensing or offer-version routes, whose domain owners
# are still vendor-local extraction candidates, and since ADR-0015 does not
# mount the provisioning laboratory either — its only implementation simulates.
# The target composition is `production-composed-v1`; it is declared but not
# yet adopted here — the console it publishes has one authentication owner
# (ADR-0014) but no obtainable session yet (ADR-0015 section 6).
# scripts/deploy_production.sh refuses to deploy without this exact line, and
# the application itself refuses to boot in a production environment with no
# profile at all rather than inheriting the `full` composition.
VENDOR_DEPLOYMENT_PROFILE=production-bootstrap
PLATFORM_ROOT_DOMAIN=vendor.dotmac.io
TRUSTED_HOSTS=vendor.dotmac.io
TENANCY=multi

# The application is always pinned by digest by scripts/deploy_production.sh.
VENDOR_APP_IMAGE=
VENDOR_APP_PORT=8100
VENDOR_APP_MEM_LIMIT=768m
VENDOR_APP_PIDS_LIMIT=256

# Database image and names are configuration; credentials are materialised from
# OpenBao into the host-local .env and never committed.
VENDOR_POSTGRES_IMAGE=postgres:16@sha256:056b54f00419b49289227ab12d09df508543883f407fe9935a2cec430ef8aa8d
VENDOR_DB_NAME=vendor_control_plane
VENDOR_DB_ADMIN_PASSWORD=
VENDOR_DB_APP_USER_PASSWORD=
VENDOR_DB_PLATFORM_API_PASSWORD=
# The platform outbox relay's dispatcher credential. Canonical value lives in
# OpenBao at secret/dotmac/vendor-control-plane/production/relay-dispatcher,
# field `dispatcher_password`, and is materialised into the host-local .env by
# scripts/materialize_production_secrets.py. Never committed.
#
# A SEPARATE OpenBao record from the three above, and deliberately outside the
# rotation ceremony: that ceremony's candidate set is a closed six-field value
# with an exact-match validator, so a fourth database password on the shared
# record would make a rotation refuse the candidate it had just minted.
# Extending the ceremony to a fourth role is named follow-up work, not a
# side-effect of composing the relay.
VENDOR_DB_DISPATCHER_PASSWORD=

# Kernel production secrets. Canonical values live in OpenBao.
JWT_SECRET=
SESSION_HASH_SECRET=
CSRF_ENABLED=true
# Declared here because the kernel makes it FATAL, not because it is new policy.
# `validate_settings` refuses a production CSRF_SECRET three ways — still the
# dev default, fewer than 32 bytes, or equal to JWT_SECRET/SESSION_HASH_SECRET —
# and each raises in the application lifespan. It is materialized from the same
# OpenBao runtime record as the two above.
CSRF_SECRET=
RATE_LIMIT_ENABLED=true

# Fake provisioning remains the only permitted provider in this phase.
VENDOR_PROVIDER_MODE=fake

# Start empty. After the exact Sub production manifest is held and catalogued,
# set the digest pair and restart the application. Capability codes never live
# in this configuration.
VENDOR_PRODUCT_RELEASE_PINS_JSON={}
VENDOR_PRODUCT_MANIFEST_DIRECTORY=/run/dotmac/product-manifests

# Production signing must be configured. The host file is materialised from
# OpenBao path secret/dotmac/licensing/signing-key and mounted read-only.
VENDOR_LICENCE_SIGNING_MODE=configured
VENDOR_LICENCE_SIGNING_KEY_HOST_FILE=/run/secrets/dotmac/vendor-control-plane/licence-signing/primary.key
VENDOR_LICENCE_SIGNING_KEY_FILE=/run/secrets/dotmac/vendor-control-plane/licence-signing/primary.key
VENDOR_LICENCE_SIGNING_KEY_ID=vendor-prod-1
VENDOR_LICENCE_OVERLAP_KEY_FILE=
VENDOR_LICENCE_OVERLAP_KEY_ID=
VENDOR_LICENCE_DELIVERY_MODE=logging

# The platform outbox relay (docker-compose.production.yml service `relay`).
# The lease is held BY the worker id, so two relays must never share one.
VENDOR_RELAY_WORKER_ID=vendor-cp-prod-relay-1
VENDOR_RELAY_MEM_LIMIT=256m
VENDOR_RELAY_PIDS_LIMIT=128
# Health windows. `HEARTBEAT_STALE` decides STOPPED; `SETTLED_WITHIN` is what
# separates a wedged relay from one merely behind a long queue, so it wants to
# be longer than the quietest expected gap between deliveries.
VENDOR_RELAY_OVERDUE_SECONDS=300
VENDOR_RELAY_STALE_LEASE_SECONDS=300
VENDOR_RELAY_HEARTBEAT_STALE_SECONDS=120
VENDOR_RELAY_SETTLED_WITHIN_SECONDS=600
